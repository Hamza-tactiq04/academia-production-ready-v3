# Local deployment only. Never commit the real .env file.
MYSQL_DATABASE=academia
MYSQL_USER=academia
MYSQL_PASSWORD=replace-with-a-strong-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-random-password
JWT_SECRET=replace-with-at-least-64-random-characters
VITE_APP_ID=local-academia
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
PORT=3000
# Public HTTPS origin used by mobile builds. Do not put secrets here.
ACADEMIA_SERVER_URL=https://your-domain.example
